{
  "name": "zotero-bilingual-reader",
  "type": "module",
  "version": "0.1.0",
  "description": "Zotero 10 PDF reading mode bilingual paragraph translator",
  "config": {
    "addonName": "Bilingual Reader",
    "addonID": "bilingual-reader@zotero.local",
    "addonRef": "bilingualreader",
    "addonInstance": "BilingualReader",
    "prefsPrefix": "extensions.zotero.bilingualreader"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jokerhoneyyeah/zotero-bilingual-reader.git"
  },
  "homepage": "https://github.com/jokerhoneyyeah/zotero-bilingual-reader",
  "author": "Manus AI",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "test": "zotero-plugin test"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.0-beta.13"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.2.0",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.2",
    "zotero-types": "^4.1.0-beta.4"
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "endOfLine": "lf"
  }
}
